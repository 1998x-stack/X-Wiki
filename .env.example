# Optional overrides. Defaults are portable and Chinese transcription is enabled.
XWIKI_LANGUAGE=zh
XWIKI_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
XWIKI_LLM_PROVIDER=iagent
XWIKI_LLM_MODEL=iagent/standard

# Leave empty in this example; the runtime derives the path from Path.home().
# XWIKI_RECORDINGS_DIR=/Users/your-name/Library/Group Containers/group.com.apple.VoiceMemos.shared/Recordings
# Pi is auto-discovered via PATH, ~/.local/bin/pi, /opt/homebrew/bin/pi, /usr/local/bin/pi.
# XWIKI_PI_BIN=/opt/homebrew/bin/pi

XWIKI_MIN_AGE_SECONDS=60
XWIKI_SCAN_INTERVAL_SECONDS=300
XWIKI_COMPILE_TIMEOUT_SECONDS=900
# LEGACY preserves the existing user-controlled automatic Wiki/Git workflow.
# Review-first generates private candidates under .state/ and never auto-pushes.
XWIKI_PIPELINE_MODE=legacy
# Review-first refuses the pi invocation until this is explicitly true.
# The pi provider may be a remote/external service: review its data policy.
XWIKI_ALLOW_MODEL_EGRESS=false
XWIKI_GIT_PUSH=true
XWIKI_GIT_REMOTE=origin
XWIKI_GIT_BRANCH=main
