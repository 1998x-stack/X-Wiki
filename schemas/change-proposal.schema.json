{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChangeProposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "node_id",
    "candidate_kind",
    "status",
    "created_at",
    "before_text",
    "after_text",
    "rationale",
    "evidence_span_ids",
    "confidence_bucket"
  ],
  "properties": {
    "proposal_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "node_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "candidate_kind": {
      "type": "string",
      "enum": [
        "new",
        "enrich",
        "qualify",
        "contradict",
        "no_change",
        "uncertain"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "proposed",
        "needs_evidence",
        "approved",
        "rejected",
        "superseded",
        "failed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "before_text": {
      "type": "string"
    },
    "after_text": {
      "type": "string"
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "evidence_span_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
      },
      "uniqueItems": true
    },
    "confidence_bucket": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "base_revision_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "uncertainty_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "generator": {
      "anyOf": [
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "GeneratorInfo",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "model",
            "version"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "prompt_digest": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "external_processing_approved": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "candidate_kind": {
            "const": "new"
          }
        },
        "required": [
          "candidate_kind"
        ]
      },
      "then": {
        "properties": {
          "base_revision_id": {
            "type": "null"
          },
          "before_text": {
            "const": ""
          },
          "after_text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "candidate_kind": {
            "enum": [
              "enrich",
              "qualify",
              "contradict"
            ]
          }
        },
        "required": [
          "candidate_kind"
        ]
      },
      "then": {
        "required": [
          "base_revision_id"
        ],
        "properties": {
          "base_revision_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "before_text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "after_text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence_span_ids": {
            "minItems": 1
          },
          "candidate_kind": {
            "enum": [
              "new",
              "enrich",
              "qualify",
              "contradict"
            ]
          }
        }
      }
    }
  ],
  "$comment": "no_change equality of before/after and all state transitions are enforced by Python domain contract."
}
