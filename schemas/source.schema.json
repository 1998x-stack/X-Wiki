{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "origin",
    "content_sha256",
    "created_at",
    "imported_at"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "origin": {
      "type": "string",
      "enum": [
        "voice_memo",
        "file",
        "markdown_vault",
        "manual"
      ]
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "imported_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "stored",
        "transcribing",
        "indexed",
        "failed_retryable",
        "failed_terminal"
      ]
    },
    "privacy_scope": {
      "const": "private"
    },
    "captured_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "transcript_revision_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "language": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "audio_duration_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
